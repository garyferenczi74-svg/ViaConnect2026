{
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/bos/worker", "schedule": "*/5 * * * *" },
    { "path": "/api/body/goals/recalibrate-cron", "schedule": "0 8 * * 1" },
    { "path": "/api/integrations/google-health/sync", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/hannah-research", "schedule": "0 */3 * * *" },
    { "path": "/api/integrations/whoop/process", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/synchronism-daily", "schedule": "15 6 * * *" },
    { "path": "/api/cron/hannah-compile", "schedule": "30 6 * * *" }
  ]
}

# Supabase (required — no hardcoded production fallbacks)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers (server-side only: never expose in NEXT_PUBLIC_*)
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Prompt #164: nutrition analysis pipeline
GEMINI_API_KEY=
USDA_FDC_API_KEY=
# Clinical evidence backbone for Hannah / Arnold / Jeffery / Sherlock agents (NCBI E-utilities: PubMed, ClinVar, OMIM)
NCBI_API_KEY=

# Prompt #164 (#163 fold-in): admin health-check route gate
ADMIN_HEALTH_TOKEN=

# Stripe (required for membership + shop checkout handoff)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Via Cura shop webhook (distinct signing secret if separate endpoint)
STRIPE_SHOP_WEBHOOK_SECRET=

# Vercel Cron + scheduled routes (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# LifeMetrics inbound webhook (Farmceutica Wellness y0urbrand tenant 355).
# Leave empty until tenant keys and a webhook subscription exist. Do not invent secrets.
# Webhook URL once keys exist: https://www.viaconnectapp.com/api/genetics/lifemetrics/webhook
LIFEMETRICS_WEBHOOK_SECRET=
LIFEMETRICS_API_KEY=
# LIFEMETRICS_API_URL=https://api-v2.lifemetrics.com/v1/platform-api

# Prompt 212: WHOOP / Oura + wearable token encryption
# Leave empty until provisioned. Do not invent client IDs.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=
WEARABLE_TOKEN_KEY=
# Set to 1 to enable Android Health Connect path (iOS HealthKit is default-on)
HEALTH_CONNECT_ENABLED=
NEXT_PUBLIC_HEALTH_CONNECT_ENABLED=

# App (canonical production host is www; apex redirects after DNS A record is set)
# FormaVision Meshy multi-image-to-3d (server-only). Visual GLB only — not measurements.
# Leave empty to no-op; the parametric scan-morph mesh still works. Never NEXT_PUBLIC_.
MESHY_API_KEY=

NEXT_PUBLIC_APP_URL=https://www.viaconnectapp.com
NEXT_PUBLIC_SITE_URL=https://www.viaconnectapp.com
